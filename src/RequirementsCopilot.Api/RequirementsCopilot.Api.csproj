<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RequirementsCopilot.Application\RequirementsCopilot.Application.csproj" />
    <ProjectReference Include="..\RequirementsCopilot.Infrastructure\RequirementsCopilot.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Prompts de los agentes (ADR-0008): versionados en /prompts y desplegados junto al binario. -->
  <ItemGroup>
    <Content Include="..\..\prompts\**\*.md" LinkBase="prompts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
